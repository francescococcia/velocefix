# Public origin of this app (no trailing slash), e.g. https://your-app.vercel.app
# Used to validate Twilio's X-Twilio-Signature. APP_URL is accepted as a fallback.
APP_BASE_URL=
APP_URL=

# xAI / Grok (server-side only). Leave the key blank to use keyword fallback.
# Docs: https://api.x.ai/v1/chat/completions
# Model defaults to grok-4.7 when XAI_MODEL is empty (see config/app.ts).
XAI_API_KEY=
XAI_MODEL=

# Twilio WhatsApp sandbox
# Docs: https://www.twilio.com/docs/whatsapp/sandbox
# Join by sending: join <your-sandbox-code> to +14155238886
# Sandbox "When a message comes in": POST https://<APP_BASE_URL host>/api/twilio/webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to 1 only for local curl/dev. Never enable in production.
TWILIO_SKIP_SIGNATURE=

# Parallel (optional depth — Gas Safe / official cited lookup)
PARALLEL_API_KEY=

# Cortile hackathon API (optional, read-only, event only). Server-side.
# Docs: https://hackathon.cortile.com/  — never commit the key.
CORTILE_API_KEY=
# Optional base URL override; default is https://hackathon.cortile.com
CORTILE_API_URL=

# Unused tonight (do not fill unless a later card says so)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Demo only: map a real sandbox phone to a seeded unit (set in Vercel/.env, never commit real numbers)
# Format: +447xxxxxxxxx=u-old-2,+447yyyyyyyyy=u-new-403
DEMO_PHONE_MAP=
